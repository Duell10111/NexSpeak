{
  "name": "nexspeak",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run -s build:input-hook -w @nexspeak/desktop -- --patch-only",
    "dev": "npm run dev -w @nexspeak/web",
    "build": "npm run build -w @nexspeak/web",
    "start": "npm run start -w @nexspeak/web",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @nexspeak/web",
    "test:e2e:docker": "npm run test:e2e:docker -w @nexspeak/web",
    "dev:desktop": "npm run dev -w @nexspeak/desktop",
    "start:desktop": "npm run build && npm run start -w @nexspeak/desktop",
    "dist:desktop": "npm run build && npm run dist -w @nexspeak/desktop",
    "test:e2e:desktop": "npm run build && npm run test:e2e -w @nexspeak/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "node-gyp": "13.1.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
