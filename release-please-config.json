{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "node",
      "extra-files": [
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/i18n/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/desktop'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/web'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/core'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/i18n'].version" }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "✨ Features", "hidden": false },
    { "type": "fix", "section": "🐛 Bugfixes", "hidden": false },
    { "type": "refactor", "section": "♻️ Refactor", "hidden": false },
    { "type": "chore", "section": "🔧 Chore", "hidden": false },
    { "type": "style", "section": "💄 Style", "hidden": false },
    { "type": "perf", "section": "⚡️ Performance", "hidden": false },
    { "type": "revert", "section": "⏪ Revert", "hidden": false },
    { "type": "ci", "section": "🚀 Continuous Integration", "hidden": false },
    { "type": "docs", "section": "📄 Documentation", "hidden": false }
  ]
}
