# Optional fallback for the LiveKit JWT service (MatrixRTC calls) when the homeserver
# does not advertise one. Read at build time.
# NEXT_PUBLIC_LIVEKIT_SERVICE_URL=https://livekit-jwt.example.org

# Optional public KLIPY key for the GIF picker (https://partner.klipy.com). Without it the GIF
# button is hidden. Read at build time.
# NEXT_PUBLIC_KLIPY_API_KEY=your-klipy-key
