{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Electron loads CommonJS; a sandboxed preload script cannot be an ES module.
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"]
}
